[
  {
    "id": "example-cover-pair-cover-pair-example",
    "type": "comment",
    "name": "Cover pair example",
    "info": "Two covers moved as one, such as the left and right of a curtain. The group sends each member the request, with its own request ID, on that member's own output (after the group's result on output 1); each member's second output comes back to the group, which reports ready only when both confirm, and otherwise which did what. Map each member's commands and reports to its device as in the Cover control example.",
    "x": 160,
    "y": 40,
    "wires": []
  },
  {
    "id": "example-cover-pair-open",
    "type": "inject",
    "name": "open both",
    "props": [
      {
        "p": "payload",
        "v": "open",
        "vt": "str"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "x": 130,
    "y": 100,
    "wires": [
      [
        "example-cover-pair-group"
      ]
    ]
  },
  {
    "id": "example-cover-pair-partial",
