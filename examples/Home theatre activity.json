[
  {
    "id": "example-home-theatre-activity-home-theatre-activity-example",
    "type": "comment",
    "name": "Home theatre activity example",
    "info": "The state contract turns a request on home/room/theatre/request into an activity intent. The activity controller plans each target and sends msg.theatreCommand; the switch routes each command by its target, and a change node moves it onto that controller's input. Every controller reports msg.theatre target state on output 2, wired straight back to the activity controller, which publishes a complete snapshot through the contract.\n\nSet the display controller's device hosts and TV pre-shared key before deploying; until then it shows \"invalid configuration\" and the activity waits for it. Wire the controllers' output 1 to your device transports and activity lighting to your room lighting controller.",
    "x": 190,
    "y": 40,
    "wires": []
  },
  {
    "id": "example-home-theatre-activity-request-tv-activity",
    "type": "inject",
    "name": "request tv activity",
    "props": [
      {
        "p": "topic",
        "v": "home/room/theatre/request",
        "vt": "str"
      },
      {
        "p": "payload",
        "v": "{\"requestId\":\"example-request-1\",\"activity\":\"tv\"}",
        "vt": "json"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "x": 170,
    "y": 100,
    "wires": [
      [
        "example-home-theatre-activity-theatre-state-contract"
      ]
    ]
  },
  {
