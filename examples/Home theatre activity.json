  {
    "id": "example-home-theatre-activity-home-theatre-activity-example",
    "type": "comment",
    "name": "Home theatre activity example",
    "info": "The state contract turns a request on home/room/theatre/request into an activity intent. The activity controller plans each target (display, receiver, source, lighting, backlighting) and reports a complete state snapshot, which the contract publishes as retained MQTT state.\n\nIn a real flow, route the activity controller's target commands to the equipment controllers and the activity-lighting node.",
    "x": 190,
    "y": 40,
    "wires": []
  },
  {
    "id": "example-home-theatre-activity-request-tv-activity",
    "type": "inject",
    "name": "request tv activity",
    "props": [
      {
        "p": "topic",
        "v": "home/room/theatre/request",
        "vt": "str"
      },
      {
        "p": "payload",
        "v": "{\"requestId\":\"example-request-1\",\"activity\":\"tv\"}",
        "vt": "json"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "x": 170,
    "y": 100,
    "wires": [
