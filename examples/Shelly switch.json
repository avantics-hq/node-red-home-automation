[
  {
    "id": "example-shelly-switch-comment",
    "type": "comment",
    "name": "Shelly switch example",
    "info": "A wall switch wired to a Shelly Gen2 relay in detached mode: the relay stays on to power smart bulbs, and the switch's presses drive the room's lights through the switch policy, with no function nodes. The adapter reads the device's own configuration (its mode and input type) and shows it in its status. In your flow, replace the injects marked 'from the device' with an MQTT in node subscribed to <prefix>/# (output: auto-detect), and the debug node 'to the MQTT out node' with an MQTT out node, both on your broker; wire the switch policy to your room controller. Set the adapter's MQTT topic prefix to your device's (its device ID unless you set one).",
    "x": 150,
    "y": 40,
    "wires": []
  },
  {
    "id": "example-shelly-switch-adapter",
    "type": "home-shelly-switch",
    "name": "",
    "topicPrefix": "shellyplus1-a8032ab12345",
    "channel": 0,
    "mode": "auto",
    "x": 460,
    "y": 200,
    "wires": [
      [
        "example-shelly-switch-to-device"
      ],
      [
        "example-shelly-switch-policy"
      ]
    ]
  },
  {
    "id": "example-shelly-switch-policy",
    "type": "home-switch-lighting-policy",
    "name": "",
    "area": "",
    "targets": "[\"main\"]",
    "switchWindowMs": 500,
    "switchFreshnessSeconds": 3600,
    "x": 700,
    "y": 240,
    "wires": [
      [
        "example-shelly-switch-intents"
      ]
    ]
  },
  {
    "id": "example-shelly-switch-to-device",
    "type": "debug",
    "name": "to the MQTT out node",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "true",
    "targetType": "full",
    "statusVal": "",
    "statusType": "auto",
    "x": 700,
    "y": 160,
    "wires": []
  },
  {
    "id": "example-shelly-switch-intents",
    "type": "debug",
    "name": "lighting intents (to the room controller)",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "true",
    "targetType": "full",
    "statusVal": "",
    "statusType": "auto",
    "x": 960,
    "y": 240,
    "wires": []
  },
  {
    "id": "example-shelly-switch-config",
    "type": "inject",
    "name": "configuration reply, from the device",
    "props": [
      {
        "p": "payload",
        "v": "{\"id\": 1, \"src\": \"shellyplus1-a8032ab12345\", \"dst\": \"shellyplus1-a8032ab12345/home-automation-switch-0\", \"result\": {\"switch:0\": {\"id\": 0, \"in_mode\": \"detached\"}, \"input:0\": {\"id\": 0, \"type\": \"switch\"}}}",
        "vt": "json"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "shellyplus1-a8032ab12345/home-automation-switch-0/rpc",
    "x": 210,
    "y": 120,
    "wires": [
      [
        "example-shelly-switch-adapter"
      ]
    ]
  },
  {
    "id": "example-shelly-switch-status",
    "type": "inject",
    "name": "device status, from the device",
    "props": [
      {
        "p": "payload",
        "v": "{\"switch:0\":{\"id\":0,\"output\":true},\"input:0\":{\"id\":0,\"state\":false}}",
        "vt": "json"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "shellyplus1-a8032ab12345/status",
    "x": 200,
    "y": 160,
    "wires": [
      [
        "example-shelly-switch-adapter"
      ]
    ]
  },
  {
    "id": "example-shelly-switch-flip-on",
    "type": "inject",
    "name": "switch flipped on, from the device",
    "props": [
      {
        "p": "payload",
        "v": "{\"method\":\"NotifyStatus\",\"params\":{\"ts\":1764151200,\"input:0\":{\"id\":0,\"state\":true}}}",
        "vt": "json"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "shellyplus1-a8032ab12345/events/rpc",
    "x": 210,
    "y": 200,
    "wires": [
      [
        "example-shelly-switch-adapter"
      ]
    ]
  },
  {
    "id": "example-shelly-switch-flip-off",
    "type": "inject",
    "name": "switch flipped off, from the device",
    "props": [
      {
        "p": "payload",
        "v": "{\"method\":\"NotifyStatus\",\"params\":{\"ts\":1764151201,\"input:0\":{\"id\":0,\"state\":false}}}",
        "vt": "json"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "shellyplus1-a8032ab12345/events/rpc",
    "x": 210,
    "y": 240,
    "wires": [
      [
        "example-shelly-switch-adapter"
      ]
    ]
  },
  {
    "id": "example-shelly-switch-online",
    "type": "inject",
    "name": "online, from the device",
    "props": [
      {
        "p": "payload",
        "v": "true",
        "vt": "str"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "shellyplus1-a8032ab12345/online",
    "x": 180,
    "y": 280,
    "wires": [
      [
        "example-shelly-switch-adapter"
      ]
    ]
  }
]
