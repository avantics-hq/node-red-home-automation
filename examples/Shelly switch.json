        "p": "payload",
        "v": "{\"src\":\"shellyplus1pm-a8032ab12345\",\"dst\":\"shellyplus1pm-a8032ab12345/events\",\"method\":\"NotifyStatus\",\"params\":{\"ts\":1764151200,\"switch:0\":{\"id\":0,\"output\":false}}}",
        "vt": "json"
