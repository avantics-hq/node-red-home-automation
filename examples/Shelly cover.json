        "p": "cover",
        "v": "{\"kind\":\"startup\"}",
        "vt": "json"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": 3,
    "topic": "",
    "x": 130,
    "y": 100,
    "wires": [
      [
        "example-shelly-cover-cover"
      ]
    ]
  },
