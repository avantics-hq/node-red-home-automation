        "vt": "json"
      },
      {
        "p": "source",
        "v": "switch",
        "vt": "str"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "x": 150,
    "y": 220,
    "wires": [
      [
        "example-room-lighting-switch-lighting-policy"
