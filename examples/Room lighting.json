[
  {
    "id": "example-room-lighting-room-lighting-example",
    "type": "comment",
    "name": "Room lighting example",
    "info": "Motion and illuminance feed occupancy fusion and the motion policy; a wall switch feeds the switch policy. Both send lighting intents to the room controller, which owns the light's commands.\n\nReplace the inject nodes with your sensors and wire the room controller's output to your MQTT broker. Set the room's wake and bed times (Node-RED host time) before deploying. Give the room controller an area to publish each light's control state, its circadian switch and Home Assistant discovery; without one it still controls the lights.",
    "x": 170,
    "y": 40,
    "wires": []
  },
  {
    "id": "example-room-lighting-motion-detected",
    "type": "inject",
    "name": "motion detected",
    "props": [
      {
        "p": "payload",
        "v": "{\"motion\":true}",
        "vt": "json"
      },
      {
        "p": "source",
        "v": "motion",
        "vt": "str"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "x": 150,
    "y": 100,
    "wires": [
      [
        "example-room-lighting-occupancy-fusion"
      ]
    ]
  },
  {
    "id": "example-room-lighting-illuminance-5-lx",
    "type": "inject",
    "name": "illuminance 5 lx",
    "props": [
      {
        "p": "payload",
        "v": "5",
        "vt": "num"
      },
      {
        "p": "source",
        "v": "illuminance",
        "vt": "str"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "x": 150,
    "y": 160,
    "wires": [
      [
        "example-room-lighting-motion-lighting-policy"
      ]
    ]
  },
  {
    "id": "example-room-lighting-wall-switch-edge",
