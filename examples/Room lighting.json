[
  {
    "id": "example-room-lighting-room-lighting-example",
    "type": "comment",
    "name": "Room lighting example",
    "info": "Motion and illuminance feed occupancy fusion and the motion policy; a wall switch feeds the switch policy. Both send lighting intents to the room controller, which owns the light's commands. The circadian lighting policy sends the room how its lights should look over the day; the room uses it for lights nobody has set otherwise.\n\nReplace the inject nodes with your sensors. The room reaches its light through the zigbee2mqtt light node: set its friendly name, wire the room's first output and the light node's first output to MQTT out, and an MQTT in node on the light's topics (zigbee2mqtt/<your light>/#) into the light node. Set the circadian policy's wake and bed times (Node-RED host time) before deploying. Give the room controller an area to publish each light's control state and its Home Assistant discovery, and the circadian policy one to publish its circadian and sleep switches; without one they still control and style the lights.",
    "x": 170,
    "y": 40,
    "wires": []
  },
  {
    "id": "example-room-lighting-motion-detected",
    "type": "inject",
    "name": "motion detected",
    "props": [
      {
        "p": "payload",
        "v": "{\"motion\":true}",
        "vt": "json"
      },
      {
        "p": "source",
        "v": "motion",
        "vt": "str"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "x": 150,
    "y": 100,
    "wires": [
