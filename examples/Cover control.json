    "presets": "{\"partial\":60}",
    "positionTolerance": 2,
    "invert": false,
    "travelTimeoutMs": 90000,
    "maxAttempts": 2,
    "pollMs": 5000,
    "settleMs": 5000,
    "x": 640,
