  {
    "id": "example-cover-control-from-device",
    "type": "function",
    "name": "from Zigbee2MQTT",
    "func": "// A Zigbee2MQTT cover's state report (from an MQTT in node on its topic)\n// as what the cover controller reads. Position 100 is open.\nconst report = typeof msg.payload === \"string\" ? JSON.parse(msg.payload) : msg.payload;\nif (!report || typeof report.position !== \"number\") return null;\nconst motion = [\"opening\", \"closing\", \"stopped\"].includes(report.motor_state) ? report.motor_state : undefined;\nreturn {cover: {\n  kind: \"observed\",\n  position: report.position,\n  motion,\n  observedAt: new Date().toISOString(),\n  battery: typeof report.battery === \"number\" ? report.battery : undefined,\n  charging: typeof report.charging_status === \"string\" ? report.charging_status : undefined\n}};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 320,
    "wires": [
      [
        "example-cover-control-cover"
      ]
    ]
  },
  {
    "id": "example-cover-control-cover",
    "type": "home-cover-controller",
    "name": "",
    "area": "",
    "presets": "{\"partial\":60}",
    "positionTolerance": 2,
    "invert": false,
    "travelTimeoutMs": 90000,
    "maxAttempts": 2,
    "pollMs": 5000,
    "settleMs": 5000,
    "x": 640,
    "y": 200,
    "wires": [
      [
        "example-cover-control-to-device"
      ],
      [
        "example-cover-control-state"
      ],
      [
        "example-cover-control-pause-motion"
      ]
    ]
  },
  {
    "id": "example-cover-control-to-device",
    "type": "function",
    "name": "to Zigbee2MQTT",
    "func": "// Neutral cover commands to a Zigbee2MQTT cover. Put your cover's name in\n// the topic; wire the result to an MQTT out node.\nconst topic = \"zigbee2mqtt/<your cover>\";\nconst command = msg.cover_command;\nif (command.operation === \"observe\") return {topic: topic + \"/get\", payload: {position: \"\"}};\nif (command.operation === \"stop\") return {topic: topic + \"/set\", payload: \"STOP\"};\nreturn {topic: topic + \"/set\", payload: {position: command.position}};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 880,
    "y": 140,
    "wires": [
      [
        "example-cover-control-device-commands"
      ]
    ]
  },
