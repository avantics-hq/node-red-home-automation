  {
    "id": "example-cover-control-pause-motion",
    "type": "function",
    "name": "pause motion while moving",
    "func": "// While the cover moves, switch this room's motion lighting off, and back\n// on when it stops: wire to the motion lighting policy.\nreturn {source: \"area-enabled\", payload: msg.payload ? \"OFF\" : \"ON\"};",
    "outputs": 1,
