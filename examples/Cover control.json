  {
    "id": "example-cover-control-pause-motion",
    "type": "function",
    "name": "pause motion while moving",
    "func": "// While the cover moves, pause this room's motion lighting, and release\n// the pause when it stops: wire to the motion lighting policy. A pause\n// never touches the motion policy's enable, which is the user's own.\nreturn {source: \"pause\", owner: \"cover\", payload: msg.payload === true};",
    "outputs": 1,
